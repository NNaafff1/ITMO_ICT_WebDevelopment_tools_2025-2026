# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в репозиторий не коммитится (см. .gitignore).

# --- База данных ---
DB_NAME=teamfinder
DB_USER=postgres
DB_PASSWORD=postgres

# --- Безопасность ---
# Сгенерируйте свой:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_in_production_please
